---
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import { publicWork } from '../lib/rolls';
---

<Base title="Public Work" description="Shows, prints, and published work.">
  <div class="page-head">
    <h1>Shows, prints, and published frames.</h1>
    <p>
      Selected work that has been featured in public galleries or shows.
    </p>
  </div>

  {
    publicWork.length === 0 ? (
      <div class="empty-state">
        <p>Nothing here yet.</p>
        <p>
          Add <code>"public": true</code> to any <code>rolls/&lt;roll&gt;/roll.json</code> to feature it on this page.
        </p>
      </div>
    ) : (
      publicWork.map((roll, i) => <Gallery roll={roll} priority={i === 0} />)
    )
  }
</Base>
