---
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import { rolls } from '../lib/rolls';
import { site } from '../site.config';

const initial = rolls.slice(0, site.initialGalleries);
const pending = rolls.slice(site.initialGalleries).map((roll) => roll.slug);
---

<Base title="Recent Rolls" description="The most recent rolls of 35mm film, newest first.">
  <div class="page-head">
    <h1>Just Roll With It</h1>
    <p>
      I started my journey with film photography in April of 2025 after buying my Pentax K1000 at Golden Hour Cameras in Tacoma, WA. 
    </p>
    <p>
      Any time you're working with color negative images there is some amount of <i>editing</i> that happens.
      Some people don't believe in editing their scans from the lab, but every scan or print is someone's opinion of what looks rights.
    </p>
    <p>
      This site is a gallery to help show what I've captured, developed, and scanned. When possible I will mention the lab and scanning processes used.
      Above all, it is a place to see my work: for better or for worse.
    </p>
  </div>

  {
    rolls.length === 0 ? (
      <div class="empty-state">
        <p>No rolls yet.</p>
        <p>
          Drop a folder of scans into <code>rolls/</code> — or run <code>npm run ingest -- ./scans "Roll title"</code> —
          and it will show up here on the next build.
        </p>
      </div>
    ) : (
      <div
        class="feed"
        data-feed
        data-batch={site.galleriesPerBatch}
        data-pending={JSON.stringify(pending)}
      >
        <div data-feed-list>
          {initial.map((roll, i) => (
            <Gallery roll={roll} priority={i === 0} />
          ))}
        </div>
        <div class="feed__sentinel" data-feed-sentinel />
        <p class="feed__status" data-feed-status />
        <button class="feed__more" type="button" data-feed-more hidden>
          Load more rolls
        </button>
      </div>
    )
  }

  <script>
    import '../scripts/feed.ts';
  </script>
</Base>
